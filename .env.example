# ---------------------------------------------------------------------------
# DRAGON (R) | THE BIRTHDAY ISSUE - environment
# Everything below is OPTIONAL. The site runs fully without it (local drafts,
# Spotify embeds). Configure these to unlock cloud persistence + SDK playback.
# ---------------------------------------------------------------------------

# Supabase (Time Capsule cloud storage + saved cake designs)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Time capsule unlock gate (server-validated). ISO date.
TIME_CAPSULE_UNLOCK_DATE=2027-01-01

# Optional: Spotify Web Playback SDK (requires a Spotify Premium listener).
# Without these the player falls back to the official Spotify embed.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
